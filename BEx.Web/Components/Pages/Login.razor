@page "/"
@using System.Security.Cryptography
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject IServiceProvider Services

<PageTitle>BEx Login</PageTitle>

<div class="connected-row px-4">
    <div class="title-text">Backlog Expedition</div>
</div>

<div class="login-container">
    <h2>Archipelago Login</h2>

    <div class="form-group">
        <label>Host and Port</label>
        <input @bind="HostPort" class="form-control" placeholder="Example: archipelago.gg:12345" />
    </div>

    <div class="form-group">
        <label>Player Name</label>
        <input @bind="PlayerName" class="form-control" placeholder="Example: MyBExName" />
    </div>

    <div class="form-group">
        <label>Password</label>
        <input @bind="Password" type="password" class="form-control" placeholder="Leave blank if no password" />
    </div>

    <button class="button" @onclick="LoginAndConnect">
        Login & Connect
    </button>
</div>

@code {
    string? HostPort = "";
    string? PlayerName = "";
    string? Password = "";

    protected override async Task OnInitializedAsync()
    {
        HostPort = await GetLastSessionPort();
        PlayerName = await GetLastSessionPlayer();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var result = await ProtectedSessionStore.GetAsync<Guid>("CurrentPlayer");

            if (result.Success)
            {
                Guid sessionId = result.Value;
                var existingSession = SessionManager.GetSession(sessionId);

                if (existingSession != null)
                {
                    Nav.NavigateTo($"/connected", true);
                    return;
                }
                else
                {
                    await ProtectedSessionStore.DeleteAsync("CurrentPlayer");
                }
            }
        }
        catch (CryptographicException)
        {
            await ProtectedSessionStore.DeleteAsync("CurrentPlayer");
        }
    }

    private async Task<string> GetLastSessionPlayer()
    {
        try
        {
            var result = await ProtectedLocalStore.GetAsync<String>("LastPlayer");
            return result.Success ? result.Value : string.Empty;
        }
        catch (CryptographicException)
        {
            await ProtectedLocalStore.DeleteAsync("LastPlayer");
            return string.Empty;
        }
    }

    private async Task<string> GetLastSessionPort()
    {
        try
        {
            var result = await ProtectedLocalStore.GetAsync<String>("LastHost");

            return result.Success ? result.Value : string.Empty;
        }
        catch (CryptographicException)
        {
            await ProtectedLocalStore.DeleteAsync("LastHost");
            return string.Empty;
        }
    }

    private async Task LoginAndConnect()
    {
        Guid sessionId = Guid.NewGuid();

        await ProtectedLocalStore.SetAsync("hostPort", HostPort);
        await ProtectedLocalStore.SetAsync("playerName", PlayerName);

        GameSession session = SessionManager.CreateSession(
            HostPort!,
            PlayerName!,
            Password ?? "",
            Services,
            sessionId);

        if (session != null)
        {
            await ProtectedSessionStore.SetAsync("CurrentPlayer", sessionId);

            session.GoalHandler.GoalReached += () =>
            {
                Nav.NavigateTo($"/connected");
            };

            Nav.NavigateTo($"/connected");
        }
        else
        {
            Nav.NavigateTo("/");
        }
    }
}